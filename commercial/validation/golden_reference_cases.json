  "schema": "lacurent_commercial_golden_reference_v1",
  "description": "20 controlled Romanian-climate reference cases for the LaCurent Light commercial engine.",
  "source_policy": {
    "climate_input": "commercial/data/climate.json (MC001/6-2013 monthly station data)",
    "formulas": "Independent validation implementation in commercial/validation/golden_reference.py; it does not import commercial.app.engine.",
    "indicators": "Primary-energy factors and CO2 factors locked to MC001-2022 Tables 5.17/5.18 values already source-traced in the repository. Energy-class thresholds locked to MC001-2022 Tables 5.7/5.8.",
    "scope": "Controlled Light subset: explicit U-values/boundary factors, monthly heating/cooling balance, flat seasonal heating performance, SEER cooling, simple DHW performance, no PV/solar-thermal."
  },
